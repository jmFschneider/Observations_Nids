# ==============================================================================
# CONFIGURATION PRODUCTION - OBSERVATIONS NIDS (OVH)
# ==============================================================================
# Copier en .env.prod et remplir TOUTES les valeurs
# ATTENTION: Ne jamais commiter ce fichier
# ==============================================================================

# ------------------------------------------------------------------------------
# DJANGO
# ------------------------------------------------------------------------------
SECRET_KEY=GENERER-UNE-CLE-SECRETE-ICI

DEBUG=False

# Domaine de production
ALLOWED_HOSTS='["observation-nids.meteo-poelley50.fr"]'

# CSRF : doit inclure le domaine exact avec https://
CSRF_TRUSTED_ORIGINS='["https://observation-nids.meteo-poelley50.fr"]'

ADMIN_EMAIL=admin@meteo-poelley50.fr

# ------------------------------------------------------------------------------
# BASE DE DONNÉES (MariaDB)
# ------------------------------------------------------------------------------
DB_NAME=observations_nids
DB_USER=observations_user
DB_PASSWORD=MOT-DE-PASSE-FORT-ICI
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=MOT-DE-PASSE-ROOT-TRES-FORT-ICI

# ------------------------------------------------------------------------------
# SUPERUSER DJANGO (créé automatiquement au premier démarrage)
# ------------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@meteo-poelley50.fr
DJANGO_SUPERUSER_PASSWORD=MOT-DE-PASSE-ADMIN-ICI

# ------------------------------------------------------------------------------
# GEMINI API
# ------------------------------------------------------------------------------
GEMINI_API_KEY=VOTRE-CLE-GEMINI-ICI

# ------------------------------------------------------------------------------
# EMAIL (Brevo SMTP)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=VOTRE-EMAIL-BREVO@smtp-brevo.com
EMAIL_HOST_PASSWORD=VOTRE-MOT-DE-PASSE-BREVO
DEFAULT_FROM_EMAIL=noreply@meteo-poelley50.fr

# ------------------------------------------------------------------------------
# SÉCURITÉ SSL (activer car Nginx gère SSL directement)
# ------------------------------------------------------------------------------
# Ne PAS activer SECURE_SSL_REDIRECT : Nginx gère déjà la redirection HTTP→HTTPS
SECURE_SSL_REDIRECT=False

# Activer les cookies sécurisés (HTTPS uniquement)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS : 1 an (31536000 secondes)
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# ENVIRONNEMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
VERSION=1.0.0

TZ=Europe/Paris
LANGUAGE_CODE=fr-fr
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

USE_DEBUG_TOOLBAR=False
MKDOCS_USE_STATIC=True
LOG_LEVEL=INFO
